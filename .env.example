# Copy this file to .env and fill it in.
# Without a key the app runs in DEMO mode (fake sample output, no AI calls).
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# Must be a model that can see images (vision). Run `npm run models` to list yours.
AI_MODEL=claude-opus-5-5
PORT=3001

# SMS login codes (Kavenegar). Leave empty for demo: the code is shown on the login screen.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
