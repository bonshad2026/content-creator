# Postgres (docker compose maps it to 5433 so it doesn't clash with other local projects)
DATABASE_URL=postgres://cc:cc@localhost:5433/content_creator
# Redis for the job queue (BullMQ)
REDIS_URL=redis://localhost:6380
# Where uploads and results are stored (local disk driver). Relative paths are resolved from the repo root.
STORAGE_DIR=storage
# Max upload size in megabytes
MAX_UPLOAD_MB=20
