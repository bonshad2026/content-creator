# Copy this file to .env and fill it in.
# Without a key the app runs in DEMO mode (fake sample output, no AI calls).
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# Must be a model that can see images (vision). Run `npm run models` to list yours.
AI_MODEL=claude-opus-5-5
# Native reference-image editing + genuine alpha (separate from the chat model).
GAPGPT_IMAGE_MODEL=gpt-image-2.6-sunburst
PORT=3001

# SMS login codes (Kavenegar). Leave empty for demo: the code is shown on the login screen.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Serve the app under a path, e.g. /creator (for one Docker / reverse proxy with other apps). Empty = the root.
# A full URL also works (only its path is used). The proxy may keep or strip the prefix: the page uses relative URLs.
BASE_URL=
# Your phone number(s), comma-separated: only they see the admin page (Settings → پنل مدیریت) and assign plans.
ADMIN_PHONE=
# Optional: use this ffmpeg instead of the ffmpeg-static binary (e.g. /usr/bin/ffmpeg if its download fails on Linux).
# It needs libass (subtitles / Persian text).
FFMPEG_PATH=
# Per-file resumable upload limit in MiB. Browser compression is optional.
MAX_UPLOAD_MB=1024
# Raw sources of FINISHED template edits only. Active drafts and final videos are retained.
RAW_RETENTION_DAYS=7
# Private request/response diagnostics, including sampled frames. Defaults to RAW_RETENTION_DAYS.
TRACE_RETENTION_DAYS=7
